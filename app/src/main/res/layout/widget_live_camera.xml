<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет трансляции: кадр камеры на весь виджет, название и время кадра, кнопка ▶/⏸ -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:contentDescription="@string/widget_live_frame_description"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/widget_placeholder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="16dp"
        android:text="@string/widget_live_no_frame"
        android:textColor="#FF8A97B1"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_camera_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:background="@drawable/widget_chip_background"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:textColor="#FFFFFFFF"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_frame_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:background="@drawable/widget_chip_background"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:textColor="#FFFFFFFF"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_error_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="6dp"
        android:layout_marginEnd="52dp"
        android:layout_marginStart="6dp"
        android:background="#CC991B1B"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:textColor="#FFFFFFFF"
        android:textSize="11sp"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/widget_toggle_live"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="6dp"
        android:background="@drawable/widget_chip_background"
        android:contentDescription="@string/widget_live_toggle_description"
        android:src="@drawable/ic_widget_play" />
</FrameLayout>
