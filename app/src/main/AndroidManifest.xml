<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Поиск камер в сети: приём ответов ONVIF WS-Discovery (multicast) -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Живое обновление виджета трансляции (служба переднего плана) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Обратная связь: звук с микрофона планшета передаётся на динамик камеры (Hikvision, Dahua) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- Добавление камеры по QR коду: сканирование кода камерой устройства (можно и из картинки, без камеры) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:name=".DenMediaApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.DenMediaIPCams">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.DenMediaIPCams"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Настройка виджета «Камера: трансляция» — выбор камеры при добавлении на экран -->
        <activity
            android:name=".widget.LiveWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.DenMediaIPCams">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Виджет «Камера: трансляция»: кадры выбранной камеры прямо на домашнем экране -->
        <receiver
            android:name=".widget.LiveCameraWidgetProvider"
            android:exported="false"
            android:label="@string/widget_live_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_live_camera_info" />
        </receiver>

        <!-- Виджет «Камеры: список»: превью, названия и статус всех камер -->
        <receiver
            android:name=".widget.CameraListWidgetProvider"
            android:exported="false"
            android:label="@string/widget_list_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.example.denmediaipcams.widget.REFRESH_LIST" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_camera_list_info" />
        </receiver>

        <!-- Живое обновление кадра в виджете трансляции (каждые 2 секунды, пока запущена) -->
        <service
            android:name=".widget.WidgetLiveService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Отправка картинки с QR кодом камеры («Поделиться») в другие приложения -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>